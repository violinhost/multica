# --- Dependencies ---
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

# Copy workspace config and all package.json files for dependency resolution
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/docs/package.json apps/docs/
COPY packages/ui/package.json packages/ui/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/

# --ignore-scripts skips fumadocs-mdx postinstall (needs source files which
# aren't copied yet in deps stage); builder stage runs it after source copy.
RUN pnpm install --frozen-lockfile --ignore-scripts

# --- Build ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

# Copy installed dependencies (preserves pnpm symlink structure)
COPY --from=deps /app ./

# Copy source — only docs + workspace packages docs imports (ui + tsconfig).
# Avoid copying packages/views, packages/core etc. (not used by docs) to
# prevent --offline install miss on their transitive deps.
COPY package.json turbo.json pnpm-workspace.yaml ./
COPY apps/docs/ apps/docs/
COPY packages/ui/ packages/ui/
COPY packages/tsconfig/ packages/tsconfig/
COPY packages/eslint-config/ packages/eslint-config/

# Re-link after source overlay (fixes any symlinks overwritten by COPY)
# This run executes postinstall scripts (fumadocs-mdx MDX manifest generation)
# now that source content/docs/*.mdx is present.
RUN pnpm install --frozen-lockfile --offline

# Enable standalone build (Velafi fork — see next.config.mjs)
ENV STANDALONE=true

# Build the docs app (fumadocs-mdx generates MDX manifest, then next build)
RUN pnpm --filter @multica/docs build

# --- Runtime ---
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# pnpm + Docker build context absolute path leak: fumadocs-mdx's loader
# bakes in /Users/clusteradmin/agent-node/services/multica/repo/... when
# resolving symlinks during build (build context is the host repo at that
# path). At runtime in container, the loader still tries that absolute path
# and 500s every MDX page. Workaround: create the host path inside the
# container as a symlink back to /app. Ugly but lets the loader resolve.
RUN mkdir -p /Users/clusteradmin/agent-node/services/multica && \
    ln -s /app /Users/clusteradmin/agent-node/services/multica/repo

# Copy standalone output (includes traced node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.next/standalone ./
# Copy static files (not included in standalone)
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.next/static ./apps/docs/.next/static
# Copy fumadocs runtime deps — SSR of MDX pages needs:
#   - .source/ (generated MDX index + compiled source.config.mjs)
#   - source.config.ts (referenced by fumadocs loader)
#   - content/docs/ (raw MDX files for fallback resolution)
# Without these, SSR pages fall back to dev-mode compilation and 500.
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.source ./apps/docs/.source
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/source.config.ts ./apps/docs/source.config.ts
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/content ./apps/docs/content
USER nextjs

EXPOSE 4000
ENV PORT=4000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/docs/server.js"]
